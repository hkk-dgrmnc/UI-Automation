{
  "editor.codeLens": true,
  "files.associations": {
    "*.feature": "cucumber"
  },
  "editor.unicodeHighlight.allowedLocales": {
    "tr": true
  },
  "editor.unicodeHighlight.allowedCharacters": {
    "Ç": true,
    "Ğ": true,
    "İ": true,
    "Ö": true,
    "Ş": true,
    "Ü": true,
    "ç": true,
    "ğ": true,
    "ı": true,
    "ö": true,
    "ş": true,
    "ü": true
  },
  "cucumber.features": [
    "features/**/*.feature"
  ],
  "cucumber.glue": [
    "features/step-definitions/**/*.ts",
    "features/support/**/*.ts"
  ],
  "cucumberRunner.runInTerminal": true,
  "cucumberRunner.cwd": "",
  "cucumberRunner.commandTemplate": "npm.cmd test -- {featurePath}:{line}"
}
