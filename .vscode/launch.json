{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Cucumber Scenario",
      "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber.js",
      "args": [
        "${relativeFile}:${lineNumber}",
        "--require-module",
        "ts-node/register",
        "--require",
        "features/support/**/*.ts",
        "--require",
        "features/step-definitions/**/*.ts",
        "--format",
        "progress"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug YTKP-1009",
      "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber.js",
      "args": [
        "features/cases/regression/YTKP-1009.feature:4",
        "--require-module",
        "ts-node/register",
        "--require",
        "features/support/**/*.ts",
        "--require",
        "features/step-definitions/**/*.ts",
        "--format",
        "progress"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
