{
  "name": "cucumber-playwright-automation",
  "version": "1.0.0",
  "description": "Cucumber and Playwright TypeScript UI automation project.",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/run-allure-report.js cases",
    "test:smoke": "node scripts/run-allure-report.js smoke",
    "test:regression": "node scripts/run-allure-report.js regression",
    "test:chromium": "node scripts/run-allure-report.js cases --world-parameters \"{\\\"browser\\\":\\\"chromium\\\"}\"",
    "test:firefox": "node scripts/run-allure-report.js cases --world-parameters \"{\\\"browser\\\":\\\"firefox\\\"}\"",
    "test:webkit": "node scripts/run-allure-report.js cases --world-parameters \"{\\\"browser\\\":\\\"webkit\\\"}\"",
    "test:all": "npm run test:chromium && npm run test:firefox && npm run test:webkit",
    "test:headed": "node scripts/run-allure-report.js cases --world-parameters \"{\\\"browser\\\":\\\"chromium\\\",\\\"headed\\\":true}\"",
    "test:debug": "node scripts/run-allure-report.js cases --world-parameters \"{\\\"browser\\\":\\\"chromium\\\",\\\"headed\\\":true,\\\"slowMo\\\":300}\"",
    "test:allure": "node scripts/run-allure-report.js allure",
    "test:allure:smoke": "node scripts/run-allure-report.js allure-smoke",
    "test:allure:regression": "node scripts/run-allure-report.js allure-regression",
    "allure:clean": "node -e \"const fs=require('fs'); for (const p of ['allure-results','allure-report']) fs.rmSync(p,{recursive:true,force:true});\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "inventory": "ts-node scripts/check-inventory.ts",
    "inventory:check": "ts-node scripts/check-inventory.ts --check",
    "env:check": "node scripts/check-env.js",
    "live:check": "node scripts/live-check.js",
    "claude:review": "node scripts/claude-review.js",
    "claude:review:self-test": "node scripts/claude-review.js --self-test",
    "check": "npm run typecheck && npm run inventory:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@cucumber/messages": "^33.0.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.1",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
