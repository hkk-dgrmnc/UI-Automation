{
  "name": "cucumber-playwright-automation",
  "version": "1.0.0",
  "description": "Cucumber and Playwright TypeScript UI automation project.",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:chromium": "cucumber-js --world-parameters \"{\\\"browser\\\":\\\"chromium\\\"}\"",
    "test:firefox": "cucumber-js --world-parameters \"{\\\"browser\\\":\\\"firefox\\\"}\"",
    "test:webkit": "cucumber-js --world-parameters \"{\\\"browser\\\":\\\"webkit\\\"}\"",
    "test:all": "npm run test:chromium && npm run test:firefox && npm run test:webkit",
    "test:headed": "cucumber-js --world-parameters \"{\\\"browser\\\":\\\"chromium\\\",\\\"headed\\\":true}\"",
    "test:debug": "cucumber-js --world-parameters \"{\\\"browser\\\":\\\"chromium\\\",\\\"headed\\\":true,\\\"slowMo\\\":300}\"",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
