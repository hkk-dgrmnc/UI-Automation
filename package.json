{
  "name": "cucumber-playwright-automation",
  "version": "1.0.0",
  "description": "Cucumber and Playwright TypeScript UI automation project.",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --profile generated",
    "test:chromium": "cucumber-js --profile generated --world-parameters \"{\\\"browser\\\":\\\"chromium\\\"}\"",
    "test:firefox": "cucumber-js --profile generated --world-parameters \"{\\\"browser\\\":\\\"firefox\\\"}\"",
    "test:webkit": "cucumber-js --profile generated --world-parameters \"{\\\"browser\\\":\\\"webkit\\\"}\"",
    "test:all": "npm run test:chromium && npm run test:firefox && npm run test:webkit",
    "test:headed": "cucumber-js --profile generated --world-parameters \"{\\\"browser\\\":\\\"chromium\\\",\\\"headed\\\":true}\"",
    "test:debug": "cucumber-js --profile generated --world-parameters \"{\\\"browser\\\":\\\"chromium\\\",\\\"headed\\\":true,\\\"slowMo\\\":300}\"",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "inventory": "ts-node scripts/check-inventory.ts",
    "inventory:check": "ts-node scripts/check-inventory.ts --check",
    "check": "npm run typecheck && npm run inventory:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
